{
	email {$ACME_EMAIL}
	admin 127.0.0.1:2019
}

(native_proxy) {
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy {args[0]} {
		header_up X-Real-IP {remote_host}
		header_up -Forwarded
		header_up -CF-Connecting-IP
		header_up -X-Juro-Client-IP
		header_up -X-Juro-Status-Origin
		header_up -X-Juro-Lawyer-Host
		flush_interval -1
	}
}

{$SITE_HOST} {
	import native_proxy 127.0.0.1:3001
}

www.{$SITE_HOST} {
	redir https://{$SITE_HOST}{uri} permanent
}

{$APP_HOST} {
	@public_admin {
		path /api/internal/* /api/platform/admin /api/platform/admin/* /ru/admin /ru/admin/* /uz/admin /uz/admin/* /en/admin /en/admin/*
		not remote_ip 127.0.0.1 ::1
	}
	respond @public_admin 404
	import native_proxy 127.0.0.1:3000
}

{$STAGING_SITE_HOST} {
	basic_auth {
		{$STAGING_ACCESS_USER} {$STAGING_ACCESS_HASH}
	}
	import native_proxy 127.0.0.1:3101
}

{$LAWYER_HOST} {
	@public_admin {
		path /api/internal/* /api/platform/admin /api/platform/admin/* /ru/admin /ru/admin/* /uz/admin /uz/admin/* /en/admin /en/admin/*
		not remote_ip 127.0.0.1 ::1
	}
	respond @public_admin 404
	import native_proxy 127.0.0.1:3003
}

{$STATUS_HOST} {
	import native_proxy 127.0.0.1:3004
}

{$STAGING_STATUS_HOST} {
	basic_auth {
		{$STAGING_ACCESS_USER} {$STAGING_ACCESS_HASH}
	}
	import native_proxy 127.0.0.1:3104
}

{$STAGING_APP_HOST} {
	basic_auth {
		{$STAGING_ACCESS_USER} {$STAGING_ACCESS_HASH}
	}
	@public_admin {
		path /api/internal/* /api/platform/admin /api/platform/admin/* /ru/admin /ru/admin/* /uz/admin /uz/admin/* /en/admin /en/admin/*
		not remote_ip 127.0.0.1 ::1
	}
	respond @public_admin 404
	import native_proxy 127.0.0.1:3100
}

# These TLS listeners are reachable only through an operator's SSH tunnel.
https://admin.juro.uz:3443 {
	bind 127.0.0.1
	tls internal
	reverse_proxy 127.0.0.1:3002 {
		header_up Host localhost:3002
	}
}

https://admin.staging.juro.uz:3444 {
	bind 127.0.0.1
	tls internal
	reverse_proxy 127.0.0.1:3102 {
		header_up Host localhost:3102
	}
}
