# Copy to .env.self-hosted, chmod 600, and generate unique local credentials.
PRIVATE_DEVELOPMENT=true
# Private instances default to capture. Use resend only with a verified sender.
EMAIL_DELIVERY_MODE=capture
RESEND_API_KEY=
EMAIL_FROM="JURO <no-reply@juro.uz>"
POSTGRES_PASSWORD=replace-with-a-generated-password
DATABASE_URL=postgresql://juro:replace-with-a-generated-password@127.0.0.1:55432/juro
OBJECT_STORAGE_PATH=/absolute/path/to/immutable-objects
# Optional shared public corpus: configure both together with a SELECT-only role
# and a read-only public object directory. Never use production private credentials.
# CORPUS_DATABASE_URL=postgresql://corpus_reader:password@127.0.0.1:55432/juro_corpus
# CORPUS_OBJECT_STORAGE_PATH=/srv/juro/shared/corpus-objects
APP_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3001
ADMIN_CONSOLE_ORIGIN=http://localhost:3002
ADMIN_INTERNAL_TOKEN=replace-with-a-generated-token
# Independent Control Center secret: generate at least 32 random bytes; never reuse user auth keys.
ADMIN_OTP_SECRET=replace-with-an-independent-generated-secret
ADMIN_ALLOWED_EMAIL=muzaffarbekmurodov@gmail.com
ADMIN_OTP_TTL_SECONDS=300
ADMIN_OTP_RESEND_SECONDS=60
ADMIN_OTP_MAX_ATTEMPTS=5
ADMIN_SESSION_TTL_SECONDS=3600
# Production: ADMIN_CONSOLE_ORIGIN=https://admin.juro.uz
# Production console-to-platform service token (at least 32 random characters):
ADMIN_CONSOLE_TOKEN=replace-with-a-separately-generated-token
IDENTITY_PROTECTION_MODE=dual_write
# Supply an application-compatible keyring using the identity protection runbook.
IDENTITY_KEYRING='{}'
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Public deployment: PRIVATE_DEVELOPMENT=false, NODE_ENV=production,
# DEPLOYMENT_ENVIRONMENT=production (or staging), canonical HTTPS APP_URL/PUBLIC_SITE_URL.
# Generate an independent 32-byte hex secret per environment; never reuse IDENTITY_KEYRING.
# AUTH_CHALLENGE_SECRET=
# Additional public platform domains, each with matching proxy and DNS configuration:
# LAWYER_URL=https://lawyer.juro.uz
# STATUS_URL=https://status.juro.uz
# LAWYER_PORT=3003
# STATUS_PORT=3004
# Staging uses STATUS_PORT=3104. The installer assigns PLATFORM_HOST_ROLE per service.
