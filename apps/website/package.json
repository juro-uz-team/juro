{
  "name": "juro-legaltech",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "node ../../scripts/with-private-env.mjs --import ./../platform/node_modules/tsx/dist/loader.mjs server/index.ts",
    "build": "node ../../scripts/with-private-env.mjs node_modules/next/dist/bin/next build --webpack",
    "start": "node ../../scripts/with-private-env.mjs --production --import ./../platform/node_modules/tsx/dist/loader.mjs server/index.ts",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "type-check": "tsc --noEmit",
    "license:check": "node ../../scripts/check-dependency-licenses.mjs ."
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "type": "module",
  "displayName": "JURO — Юрист в кармане"
}
