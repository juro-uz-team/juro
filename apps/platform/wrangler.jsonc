{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "juro-platform-development",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": false,
  "assets": {
    "binding": "ASSETS"
  },
  "vars": {
    "APP_ENV": "development",
    "LEGAL_RETRIEVAL_ENVIRONMENT": "production",
    "ASYNC_RUNTIME_ENABLED": "false",
    "CRON_ENABLED": "false",
    "ACCOUNT_DELETION_PURGE_ENABLED": "false",
    "GUEST_AI_ENABLED": "true",
    "STAGING_SYNTHETIC_PROBES_ENABLED": "false",
    "STAGING_QUEUE_HEALTH_PROBE_ENABLED": "false",
    "PRODUCTION_SYNTHETIC_PROBES_ENABLED": "false",
    "PUBLIC_DOCUMENT_URL_IMPORT_ENABLED": "false",
    "PAYMENT_FOUNDATION_ENABLED": "true",
    "PAYMENT_SANDBOX_ENABLED": "true",
    "PAYMENT_PRODUCTION_APPROVED": "false",
    "PAYMENT_PRODUCTION_DEMO_ENABLED": "true",
    "LEGAL_LEX_INGESTION_ENABLED": "false",
    "LEGAL_LEX_METADATA_MONITOR_ENABLED": "false",
    "LEGAL_ADVICE_INGESTION_ENABLED": "false",
    "LEGAL_DIRECT_RETRIEVAL_ENABLED": "true",
    "LEGAL_CORPUS_USER_UPLOAD_AUTO_TRUST": "false",
    "LEGAL_ADVICE_SITEMAP_DISCOVERY_ENABLED": "false",
    "LEGAL_LEX_RSS_DISCOVERY_ENABLED": "false",
    "LEGAL_SOURCE_STAFF_API_ENABLED": "false",
    "LAWYER_PROFILE_DIRECTORY_ENABLED": "true",
    "IDENTITY_PROTECTION_MODE": "legacy",
    "JOB_SCHEMA_VERSION": "1",
    "EMBEDDING_MODEL": "text-embedding-3-large",
    "OPENAI_TRANSCRIPTION_MODEL": "gpt-4o-transcribe",
    "OPENAI_TTS_MODEL": "gpt-4o-mini-tts",
    "EMAIL_FROM": "JURO <no-reply@juro.uz>",
    "OPERATIONS_ALERT_EMAIL": "muzaffarbekmurodoff@gmail.com",
    "STATUS_HOSTNAME": "status.localhost"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "juro-development",
      "database_id": "d07670cf-f7bf-460c-a668-101671d4c330",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "juro-development-files"
    },
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "juro-development-backups"
    },
    {
      "binding": "QUARANTINE_BUCKET",
      "bucket_name": "juro-development-quarantine"
    }
  ],
  "services": [
    {
      "binding": "LEGAL_RETRIEVAL_SERVICE",
      "service": "juro-legal-corpus",
      "remote": true
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "DOCUMENT_ANALYSIS_QUEUE",
        "queue": "development-document-analysis"
      },
      {
        "binding": "DOCUMENT_ANALYSIS_DLQ",
        "queue": "development-document-analysis-dlq"
      },
      {
        "binding": "OCR_PROCESSING_QUEUE",
        "queue": "development-ocr-processing"
      },
      {
        "binding": "OCR_PROCESSING_DLQ",
        "queue": "development-ocr-processing-dlq"
      },
      {
        "binding": "DOCUMENT_EXPORT_QUEUE",
        "queue": "development-document-export"
      },
      {
        "binding": "EMAIL_NOTIFICATIONS_QUEUE",
        "queue": "development-email-notifications"
      },
      {
        "binding": "LEGAL_SOURCES_SYNC_QUEUE",
        "queue": "development-legal-sources-sync"
      },
      {
        "binding": "DATA_RETENTION_CLEANUP_QUEUE",
        "queue": "development-data-retention-cleanup"
      },
      {
        "binding": "NOTIFICATIONS_QUEUE",
        "queue": "development-notifications"
      }
    ],
    "consumers": []
  },
  "vectorize": [
    {
      "binding": "LEX_UZ_INDEX",
      "index_name": "development-lex-uz"
    },
    {
      "binding": "ADVICE_UZ_INDEX",
      "index_name": "development-advice-uz"
    },
    {
      "binding": "INTERNAL_LEGAL_MATERIALS_INDEX",
      "index_name": "development-internal-legal-materials"
    },
    {
      "binding": "USER_DOCUMENTS_INDEX",
      "index_name": "development-user-documents"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "PLATFORM_ANALYTICS",
      "dataset": "juro-platform-development"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "env": {
    "staging": {
      "name": "juro-platform-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "assets": {
        "binding": "ASSETS"
      },
      "version_metadata": {
        "binding": "WORKER_VERSION"
      },
      "triggers": {
        "crons": ["*/5 * * * *", "0 19 * * *"]
      },
      "vars": {
        "APP_ENV": "staging",
        "LEGAL_RETRIEVAL_ENVIRONMENT": "staging",
        "ASYNC_RUNTIME_ENABLED": "true",
        "CRON_ENABLED": "true",
        "ACCOUNT_DELETION_PURGE_ENABLED": "true",
        "MALWARE_SCAN_ENABLED": "true",
        "MALWARE_SCANNER_PROBE_ENABLED": "false",
        "STAGING_DOCUMENT_ANALYSIS_PROBE_ENABLED": "false",
        "GUEST_AI_ENABLED": "true",
        "STAGING_SYNTHETIC_PROBES_ENABLED": "true",
        "STAGING_LEGAL_EVALUATION_ENABLED": "true",
        "STAGING_QUEUE_HEALTH_PROBE_ENABLED": "true",
        "PRODUCTION_SYNTHETIC_PROBES_ENABLED": "false",
        "PUBLIC_DOCUMENT_URL_IMPORT_ENABLED": "false",
        "PAYMENT_FOUNDATION_ENABLED": "true",
        "PAYMENT_SANDBOX_ENABLED": "true",
        "PAYMENT_PRODUCTION_APPROVED": "false",
        "PAYMENT_PRODUCTION_DEMO_ENABLED": "true",
        "LEGAL_LEX_INGESTION_ENABLED": "false",
        "LEGAL_LEX_METADATA_MONITOR_ENABLED": "false",
        "LEGAL_ADVICE_INGESTION_ENABLED": "false",
        "LEGAL_DIRECT_RETRIEVAL_ENABLED": "true",
        "LEGAL_CORPUS_USER_UPLOAD_AUTO_TRUST": "false",
        "LEGAL_ADVICE_SITEMAP_DISCOVERY_ENABLED": "false",
        "LEGAL_LEX_RSS_DISCOVERY_ENABLED": "false",
        "LEGAL_SOURCE_STAFF_API_ENABLED": "false",
        "LAWYER_PROFILE_DIRECTORY_ENABLED": "true",
        "IDENTITY_PROTECTION_MODE": "dual_write",
        "JOB_SCHEMA_VERSION": "1",
        "EMBEDDING_MODEL": "text-embedding-3-large",
        "EMAIL_FROM": "JURO <no-reply@juro.uz>",
        "OPERATIONS_ALERT_EMAIL": "muzaffarbekmurodoff@gmail.com",
        "STATUS_HOSTNAME": "status.staging.juro.uz",
        "ADMIN_CONSOLE_ORIGIN": "https://admin.staging.juro.uz",
        "OPENAI_CHAT_MODEL": "gpt-5.6-luna",
        "OPENAI_RETRIEVAL_MODEL": "gpt-5.6-terra",
        "OPENAI_DEEP_MODEL": "gpt-5.6-terra",
        "OPENAI_TRANSCRIPTION_MODEL": "gpt-4o-transcribe",
        "OPENAI_TTS_MODEL": "gpt-4o-mini-tts",
        "ANTHROPIC_DOCUMENT_MODEL": "claude-sonnet-4-6",
        "ANTHROPIC_FALLBACK_MODEL": "claude-sonnet-4-6"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "juro-staging",
          "database_id": "bb716a96-b2fb-4823-90d6-6c228fed181a",
          "migrations_dir": "./drizzle"
        }
      ],
      "migrations": [
        {
          "tag": "v1-malware-scanner-container",
          "new_sqlite_classes": ["MalwareScannerContainer"]
        },
        {
          "tag": "v2-staging-legal-corpus-qdrant",
          "new_sqlite_classes": ["LegalCorpusQdrantContainer"]
        },
        {
          "tag": "v3-retire-staging-legal-corpus-qdrant",
          "deleted_classes": ["LegalCorpusQdrantContainer"]
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "MALWARE_SCANNER_CONTAINER",
            "class_name": "MalwareScannerContainer"
          }
        ]
      },
      "containers": [
        {
          "name": "juro-staging-malware-scanner",
          "class_name": "MalwareScannerContainer",
          "image": "docker.io/clamav/clamav@sha256:4de20bd9ab45a4b763c5412b769217ef5082572ebc8a63aff1a77943419e5dd8",
          "instance_type": "standard-1",
          "max_instances": 1
        }
      ],
      "services": [
        {
          "binding": "LEGAL_RETRIEVAL_SERVICE",
          "service": "juro-legal-corpus-staging"
        },
        {
          "binding": "MALWARE_SCANNER",
          "service": "juro-platform-staging"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "juro-staging-files"
        },
        {
          "binding": "BACKUP_BUCKET",
          "bucket_name": "juro-staging-backups"
        },
        {
          "binding": "QUARANTINE_BUCKET",
          "bucket_name": "juro-staging-quarantine"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "DOCUMENT_ANALYSIS_QUEUE",
            "queue": "staging-document-analysis"
          },
          {
            "binding": "DOCUMENT_ANALYSIS_DLQ",
            "queue": "staging-document-analysis-dlq"
          },
          {
            "binding": "OCR_PROCESSING_QUEUE",
            "queue": "staging-ocr-processing"
          },
          {
            "binding": "OCR_PROCESSING_DLQ",
            "queue": "staging-ocr-processing-dlq"
          },
          {
            "binding": "DOCUMENT_EXPORT_QUEUE",
            "queue": "staging-document-export"
          },
          {
            "binding": "DOCUMENT_EXPORT_DLQ",
            "queue": "staging-document-export-dlq"
          },
          {
            "binding": "EMAIL_NOTIFICATIONS_QUEUE",
            "queue": "staging-email-notifications"
          },
          {
            "binding": "LEGAL_SOURCES_SYNC_QUEUE",
            "queue": "staging-legal-sources-sync"
          },
          {
            "binding": "DATA_RETENTION_CLEANUP_QUEUE",
            "queue": "staging-data-retention-cleanup"
          },
          {
            "binding": "NOTIFICATIONS_QUEUE",
            "queue": "staging-notifications"
          },
          {
            "binding": "MALWARE_SCAN_QUEUE",
            "queue": "staging-malware-scan"
          },
          {
            "binding": "MALWARE_SCAN_DLQ",
            "queue": "staging-malware-scan-dlq"
          },
          {
            "binding": "STAGING_QUEUE_HEALTH_PROBE_QUEUE",
            "queue": "staging-queue-health"
          }
        ],
        "consumers": [
          {
            "queue": "staging-document-analysis",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "staging-document-analysis-dlq",
            "max_concurrency": 1,
            "retry_delay": 30
          },
          {
            "queue": "staging-document-analysis-dlq",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 10,
            "max_concurrency": 1,
            "retry_delay": 60
          },
          {
            "queue": "staging-ocr-processing",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "staging-ocr-processing-dlq",
            "max_concurrency": 1,
            "retry_delay": 30
          },
          {
            "queue": "staging-ocr-processing-dlq",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 10,
            "max_concurrency": 1,
            "retry_delay": 60
          },
          {
            "queue": "staging-document-export",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "staging-document-export-dlq",
            "max_concurrency": 1,
            "retry_delay": 30
          },
          {
            "queue": "staging-document-export-dlq",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 10,
            "max_concurrency": 1,
            "retry_delay": 60
          },
          {
            "queue": "staging-legal-sources-sync",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "staging-legal-sources-sync-dlq",
            "max_concurrency": 1,
            "retry_delay": 30
          },
          {
            "queue": "staging-email-notifications",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "staging-email-notifications-dlq",
            "max_concurrency": 2,
            "retry_delay": 30
          },
          {
            "queue": "staging-data-retention-cleanup",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "staging-data-retention-cleanup-dlq",
            "max_concurrency": 1,
            "retry_delay": 30
          },
          {
            "queue": "staging-notifications",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "staging-notifications-dlq",
            "max_concurrency": 2,
            "retry_delay": 30
          },
          {
            "queue": "staging-malware-scan",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "staging-malware-scan-dlq",
            "max_concurrency": 1,
            "retry_delay": 30
          },
          {
            "queue": "staging-malware-scan-dlq",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 10,
            "max_concurrency": 1,
            "retry_delay": 60
          },
          {
            "queue": "staging-queue-health",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "max_concurrency": 1,
            "retry_delay": 30
          },
          {
            "queue": "staging-legal-evaluation",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 0,
            "max_concurrency": 4
          }
        ]
      },
      "vectorize": [
        {
          "binding": "LEX_UZ_INDEX",
          "index_name": "staging-lex-uz"
        },
        {
          "binding": "ADVICE_UZ_INDEX",
          "index_name": "staging-advice-uz"
        },
        {
          "binding": "INTERNAL_LEGAL_MATERIALS_INDEX",
          "index_name": "staging-internal-legal-materials"
        },
        {
          "binding": "USER_DOCUMENTS_INDEX",
          "index_name": "staging-user-documents"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "PLATFORM_ANALYTICS",
          "dataset": "juro-platform-staging"
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "ai": {
        "binding": "AI"
      }
    },
    "production": {
      "name": "juro",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "app.juro.uz",
          "zone_name": "juro.uz",
          "custom_domain": true
        },
