{
  "name": "juro-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node ../../scripts/with-private-env.mjs --import ./node_modules/tsx/dist/loader.mjs server/index.ts",
    "build": "node ../../scripts/with-private-env.mjs node_modules/next/dist/bin/next build --webpack",
    "start": "node ../../scripts/with-private-env.mjs --production --import ./node_modules/tsx/dist/loader.mjs server/index.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "type-check": "tsc --noEmit",
    "license:check": "node ../../scripts/check-dependency-licenses.mjs .",
    "jobs": "node ../../scripts/with-private-env.mjs --import ./node_modules/tsx/dist/loader.mjs server/jobs.ts",
    "db:migrate": "node ../../scripts/with-private-env.mjs --import ./node_modules/tsx/dist/loader.mjs scripts/migrate-postgres.mts",
    "install:ci": "npm ci",
    "test": "node scripts/test-self-hosted.mjs",
    "test:auth-browser": "node --test tests/browser/auth.test.mjs",
    "db:generate": "drizzle-kit generate",
    "backup": "node ../../scripts/with-private-env.mjs --import ./node_modules/tsx/dist/loader.mjs scripts/backup-self-hosted.mts",
    "evaluate:legal:validate-agent": "tsx scripts/validate-staging-legal-evaluation-agent.ts",
    "evaluate:legal:build-agent": "tsx scripts/build-staging-legal-agent-artifacts.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-select": "^2.3.7",
    "altcha": "3.2.3",
    "altcha-lib": "2.5.0",
    "diff": "9.0.0",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.2",
    "gpt-tokenizer": "4.0.0",
    "lucide-react": "^1.25.0",
    "next": "16.3.4",
    "parse5": "8.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "8.16.3",
    "pizzip": "^3.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "4.18.11",
    "remark-gfm": "^4.0.1",
    "unpdf": "1.8.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "@types/pizzip": "^3.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "playwright": "1.63.0",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.4",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.4",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module",
  "displayName": "JURO — Личный кабинет"
}
