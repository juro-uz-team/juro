{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "juro-legal-source-observer-development",
  "main": "./worker/legal-source-observer-worker.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": {"cpu_ms": 120000, "subrequests": 1000},
  "vars": {"LEGAL_SOURCE_OBSERVATIONS_ENABLED": "false"},
  "triggers": {"crons": []},
  "d1_databases": [{"binding": "LEGAL_DB", "database_name": "juro-legal-catalog-development", "migrations_dir": "./legal-drizzle"}],
  "observability": {"enabled": true, "logs": {"enabled": true, "head_sampling_rate": 1, "invocation_logs": true}},
  "env": {
    "staging": {
      "name": "juro-legal-source-observer-staging",
      "vars": {"LEGAL_SOURCE_OBSERVATIONS_ENABLED": "true"},
      "triggers": {"crons": ["* * * * *"]},
      "d1_databases": [{"binding": "LEGAL_DB", "database_name": "juro-legal-catalog-staging-green3-20260905",
        "database_id": "10c71209-7cf6-47c3-a74e-9697e32d7c29", "migrations_dir": "./legal-drizzle"}]
    },
    "production": {
      "name": "juro-legal-source-observer-production",
      "vars": {"LEGAL_SOURCE_OBSERVATIONS_ENABLED": "true"},
      "triggers": {"crons": ["* * * * *"]},
      "d1_databases": [{"binding": "LEGAL_DB", "database_name": "juro-legal-catalog-production-green-20260908",
        "database_id": "4381cd22-4b1f-461c-9654-bc29789039c1", "migrations_dir": "./legal-drizzle"}]
    }
  }
}
