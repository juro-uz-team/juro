{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "typeRoots": [
      "../platform/node_modules/@types"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "runtime-contracts.d.ts",
    "src/**/*.ts"
  ]
}
