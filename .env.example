# Server-side OpenAI integration used by apps/platform/document-builder.
# Never expose this key through NEXT_PUBLIC_* variables.
OPENAI_API_KEY=

# Optional model override.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_DEEP_MODEL=gpt-5.6-terra

# Optional base URL used only by the document-builder smoke test.
JURO_SMOKE_BASE_URL=http://127.0.0.1:4180

# Optional server-only email OTP integration. Configure only in the hosting secret store.
RESEND_API_KEY=
EMAIL_FROM=JURO <no-reply@juro.uz>

# Cloudflare bindings are not string environment variables:
# - DB     -> D1 database binding
# - BUCKET -> private R2 bucket binding
# They must be configured in the hosting control plane.
